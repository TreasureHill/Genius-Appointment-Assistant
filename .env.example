# Copy to .env and fill in real values

# --- Core ---
MONGO_URL=mongodb://127.0.0.1:27017/genius
PORT=4000
# Interface to listen on; blank = all. Production behind Caddy on the same
# machine: 127.0.0.1 (deploy.ps1 sets it), so :4000 isn't reachable directly.
HOST=
NODE_ENV=development
# Public base URL. Portal links in emails and the DocuSign Connect webhook are
# built from it, so production needs the real https address.
APP_URL=http://localhost:4000
# Required in production (the server refuses to start with the built-in default).
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false

# --- Admin seed (only used when no user exists) ---
ADMIN_USER=admin
ADMIN_PASS=changeme

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Genius Appointments <no-reply@example.com>"

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Calendly ---
CALENDLY_TOKEN=
CALENDLY_ORG_URI=
# Optional: owner's Calendly user URI (https://api.calendly.com/users/XXXX).
# Usually set in Settings → Owner; this env var is a fallback used by the
# reconcile script (npm run reconcile:calendly) so it can run headless.
CALENDLY_USER_URI=
CALENDLY_WEBHOOK_SECRET=
# Event Type URI Aria offers over the phone
# (https://api.calendly.com/event_types/XXXX). Used to read real availability
# and to mint the scheduling link the homeowner confirms. Usually set in
# Settings → Aria; this is a headless fallback.
CALENDLY_EVENT_TYPE_URI=

# --- ElevenLabs Conversational AI ("Aria" outbound calling) ---
# ElevenLabs places the call via their own managed Twilio integration, so no
# extra Twilio config is needed for voice. Leave blank to disable the Call
# button (everything else still works).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
# HMAC secret verifying post-call webhooks at /api/webhooks/elevenlabs.
# Configure the same value in the ElevenLabs agent's webhook settings.
ELEVENLABS_WEBHOOK_SECRET=
# Shared secret the agent presents (x-aria-secret header) when it calls our
# availability / booking server tools mid-call. Set the same value on each
# tool in the ElevenLabs agent's Tools config. Leave blank to accept
# unsigned tool calls (dev only).
ARIA_TOOL_SECRET=

# --- Google reviews (Reviews tab) ---
# SerpApi key for the Google Maps Reviews engine (serpapi.com). Can also be
# pasted into the Reviews tab → Setup, which takes precedence over this.
SERPAPI_KEY=
# Google Maps place_id of the listing to track. Defaults to the
# "Treasure Hill - Corporate" listing (101 Bradwick Dr) when blank.
GOOGLE_PLACE_ID=

# --- Homeowner portal (/portal) + HST ---
# Optional, at least 32 random characters. Blank = derived from JWT_SECRET
# (HMAC). Must never equal JWT_SECRET — the server refuses to start if it does.
PORTAL_JWT_SECRET=
# Printed on receipts and upcoming-invoice emails. Also set it in Stripe's
# invoice settings.
HST_REGISTRATION_NUMBER=

# --- Stripe (alarm monitoring subscriptions) ---
# Leave blank to disable billing; everything else still works.
# sk_test_… or sk_live_… (test/live mode is taken from the prefix).
STRIPE_SECRET_KEY=
# whsec_… for /api/webhooks/stripe (`stripe listen` prints one for dev).
# Required in production: without it the webhook answers 503.
STRIPE_WEBHOOK_SECRET=
# txr_… the 13% Ontario HST tax rate (exclusive). `npm run stripe:bootstrap
# -w server` creates it and prints the id.
STRIPE_TAX_RATE_ID=
# Optional price id overrides. Blank = look up the prices by lookup_key
# (genius_monitoring_basic_monthly / genius_monitoring_smart_monthly).
STRIPE_PRICE_BASIC=
STRIPE_PRICE_SMART=
# Pin the API version; must equal the webhook endpoint's version in the Stripe
# dashboard. Blank = the version the installed stripe package ships with.
STRIPE_API_VERSION=
# Dev only: attach new customers to a Stripe test clock.
STRIPE_TEST_CLOCKS=0

# --- DocuSign (alarm monitoring agreements) ---
# Leave blank to disable e-signing; everything else still works.
# demo → account-d.docusign.com, prod → account.docusign.com
DOCUSIGN_ENV=demo
DOCUSIGN_INTEGRATION_KEY=
# The API Username (GUID) of the DocuSign user we act as.
DOCUSIGN_USER_ID=
# Optional; blank = the user's default account from /oauth/userinfo.
DOCUSIGN_ACCOUNT_ID=
# The integration key's RSA private key: either inline PEM with \n escapes,
# or a path to the .pem file. Keep the file OUTSIDE the repo folder.
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_PRIVATE_KEY_PATH=
# Connect HMAC secret(s), comma-separated during a key rotation. Required in
# production: without it /api/webhooks/docusign answers 503.
DOCUSIGN_CONNECT_HMAC_KEYS=
# Redirect URI registered on the integration key; only used for the one-time
# consent link. Blank = {APP_URL}/settings.
DOCUSIGN_REDIRECT_URI=

# --- Pacing (fallback global defaults; projects can override) ---
DEFAULT_PACING_MIN_SEC=30
DEFAULT_PACING_MAX_SEC=120
DEFAULT_REMINDER_DAYS=14
DEFAULT_MAX_REMINDERS=3
